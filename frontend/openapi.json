{
  "components": {
    "schemas": {
      "Assessment": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "insufficient"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "data_sale_status": {
            "const": "unknown",
            "default": "unknown",
            "title": "Data Sale Status",
            "type": "string"
          },
          "evidence_state": {
            "enum": [
              "observed",
              "inferred"
            ],
            "title": "Evidence State",
            "type": "string"
          },
          "limitations": {
            "default": [
              "PHASE0_NO_ANALYSIS"
            ],
            "items": {
              "const": "PHASE0_NO_ANALYSIS",
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "rationale_codes": {
            "items": {
              "enum": [
                "TRANSACTION_INDICATION",
                "IDENTITY_CONTEXT",
                "HEALTH_CONTEXT",
                "ACCOUNT_RELATIONSHIP",
                "MARKETING_ONLY",
                "VISIT_ONLY",
                "AMBIGUOUS_EVIDENCE"
              ],
              "type": "string"
            },
            "maxItems": 7,
            "title": "Rationale Codes",
            "type": "array"
          },
          "relationship_id": {
            "format": "uuid",
            "title": "Relationship Id",
            "type": "string"
          },
          "retention_status": {
            "const": "unknown",
            "default": "unknown",
            "title": "Retention Status",
            "type": "string"
          },
          "review_priority": {
            "enum": [
              "sensitive",
              "medium",
              "low",
              "unknown"
            ],
            "title": "Review Priority",
            "type": "string"
          },
          "ruleset_version": {
            "const": "not_implemented",
            "default": "not_implemented",
            "title": "Ruleset Version",
            "type": "string"
          }
        },
        "required": [
          "relationship_id",
          "evidence_state",
          "confidence",
          "review_priority",
          "rationale_codes"
        ],
        "title": "Assessment",
        "type": "object"
      },
      "DemoSnapshot": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "assessments": {
            "items": {
              "$ref": "#/components/schemas/Assessment"
            },
            "maxItems": 0,
            "title": "Assessments",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "maxItems": 0,
            "title": "Evidence",
            "type": "array"
          },
          "mode": {
            "const": "synthetic_demo",
            "default": "synthetic_demo",
            "title": "Mode",
            "type": "string"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "maxItems": 0,
            "title": "Observations",
            "type": "array"
          }
        },
        "title": "DemoSnapshot",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "evidence_role": {
            "enum": [
              "primary",
              "corroborating",
              "context"
            ],
            "title": "Evidence Role",
            "type": "string"
          },
          "observation_id": {
            "format": "uuid",
            "title": "Observation Id",
            "type": "string"
          },
          "relationship_id": {
            "format": "uuid",
            "title": "Relationship Id",
            "type": "string"
          }
        },
        "required": [
          "relationship_id",
          "observation_id",
          "evidence_role"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "mode": {
            "const": "synthetic_demo",
            "default": "synthetic_demo",
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Observation": {
        "additionalProperties": false,
        "description": "Future minimized output. No arbitrary metadata or raw-content fields.",
        "properties": {
          "adapter": {
            "enum": [
              "email_eml_v1",
              "browser_chrome_json_v1"
            ],
            "title": "Adapter",
            "type": "string"
          },
          "batch_id": {
            "format": "uuid",
            "title": "Batch Id",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "maxLength": 253,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "kind": {
            "enum": [
              "site_visit_observed",
              "registration_email_detected",
              "transaction_email_detected",
              "marketing_email_detected",
              "account_notification_detected",
              "unclassified_observation"
            ],
            "title": "Kind",
            "type": "string"
          },
          "observation_id": {
            "format": "uuid",
            "title": "Observation Id",
            "type": "string"
          },
          "occurred_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "summary_code": {
            "enum": [
              "VISIT_RECORDED",
              "WELCOME_MESSAGE_PATTERN",
              "ORDER_CONFIRMATION_PATTERN",
              "MARKETING_PATTERN",
              "ACCOUNT_NOTIFICATION_PATTERN",
              "UNCLASSIFIED"
            ],
            "title": "Summary Code",
            "type": "string"
          }
        },
        "required": [
          "observation_id",
          "batch_id",
          "adapter",
          "kind",
          "domain",
          "occurred_at",
          "summary_code"
        ],
        "title": "Observation",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local scaffold only. No record ingestion or analysis endpoints.",
    "title": "PV1 synthetic Phase 0 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/demo": {
      "get": {
        "operationId": "demo_api_v1_demo_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoSnapshot"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Demo"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Process liveness only; does not assert database readiness.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
