        "kind": {
          "const": "site_visit_observed",
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "maxLength": 27,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?:[0-9]{3}|[0-9]{6})Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Occurred At"
        },
        "order_keys": {
          "items": {
            "maxLength": 10,
            "pattern": "^order(?:[0-9]{4}|10000)$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Order Keys",
          "type": "array"
        },
        "record_index": {
          "exclusiveMaximum": 10000,
          "minimum": 0,
          "title": "Record Index",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 5,
          "pattern": "^s[0-9]{4}$",
          "title": "Source Id",
          "type": "string"
        },
        "time_status": {
          "enum": [
            "valid",
            "invalid",
            "missing"
          ],
          "title": "Time Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "record_index",
        "domain",
        "occurred_at",
        "time_status",
        "order_keys",
        "duplicate_of",
        "issue_code",
        "adapter",
        "kind",
        "attribution",
        "features"
      ],
      "title": "HistoryObservation",
