        },
        "issue_code": {
          "anyOf": [
            {
              "enum": [
                "OK",
                "EMAIL_UNCLASSIFIED",
                "DUPLICATE_RECORD",
                "INVALID_TIMESTAMP",
                "INVALID_URL",
                "INVALID_RECORD",
                "INVALID_JSON",
                "JSON_LIMIT",
                "MALFORMED_MIME",
                "UNSUPPORTED_ENCODING",
                "MISSING_SENDER",
                "ORIGIN_CONFLICT",
                "HTML_ONLY_IGNORED",
                "UNAVAILABLE_HISTORY",
                "NOT_APPROVED_SYNTHETIC",
                "FILE_LIMIT",
                "BATCH_LIMIT",
                "RECORD_LIMIT",
                "UNSUPPORTED_FILE",
                "PARSER_TIMEOUT",
                "PARSER_FAILED"
              ],
              "type": "string"
