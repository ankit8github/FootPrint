    "MinimizedBatch": {
      "additionalProperties": false,
      "properties": {
        "assessment_version": {
          "const": "sensitivity_rules_v1",
          "title": "Assessment Version",
          "type": "string"
        },
        "commercial_groups": {
          "items": {
            "$ref": "#/$defs/CommercialGroup"
          },
          "maxItems": 10000,
          "title": "Commercial Groups",
          "type": "array"
        },
        "context_version": {
          "const": "email_context_v1",
          "title": "Context Version",
          "type": "string"
        },
        "contexts": {
          "items": {
            "$ref": "#/$defs/Context"
          },
          "maxItems": 10000,
          "title": "Contexts",
          "type": "array"
        },
        "duplicate_groups": {
          "items": {
            "items": {
              "maxLength": 12,
              "pattern": "^s[0-9]{4}:r[0-9]{5}$",
              "type": "string"
            },
            "maxItems": 10000,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 10000,
          "title": "Duplicate Groups",
          "type": "array"
        },
        "excluded": {
          "items": {
            "$ref": "#/$defs/Excluded"
          },
          "maxItems": 10000,
          "title": "Excluded",
          "type": "array"
        },
        "feature_version": {
          "const": "email_features_v1",
          "title": "Feature Version",
          "type": "string"
        },
        "fusion_version": {
          "const": "relationship_fusion_v1",
          "title": "Fusion Version",
          "type": "string"
        },
        "observations": {
          "items": {
            "discriminator": {
              "mapping": {
                "browser_chrome_json_v1": "#/$defs/HistoryObservation",
                "email_eml_v1": "#/$defs/EmailObservation"
              },
              "propertyName": "adapter"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EmailObservation"
              },
              {
                "$ref": "#/$defs/HistoryObservation"
              }
            ]
          },
          "maxItems": 10000,
          "title": "Observations",
          "type": "array"
        },
        "parser_version": {
          "const": "phase2-normalized-v1",
          "title": "Parser Version",
          "type": "string"
        },
        "schema_version": {
          "const": "minimized-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 20,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "parser_version",
        "feature_version",
        "fusion_version",
        "context_version",
        "assessment_version",
        "sources",
        "observations",
        "excluded",
        "contexts",
        "duplicate_groups",
        "commercial_groups"
      ],
      "title": "MinimizedBatch",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "email_eml_v1",
            "browser_chrome_json_v1"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "record_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 5,
          "pattern": "^s[0-9]{4}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "adapter",
        "record_count"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch": {
      "$ref": "#/$defs/MinimizedBatch"
    },
    "consent_epoch": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Consent Epoch",
      "type": "integer"
    },
    "consent_version": {
      "const": "fictional-admission-consent-v1",
      "title": "Consent Version",
      "type": "string"
    },
    "expected_revision": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    }
  },
  "required": [
    "consent_version",
    "consent_epoch",
    "expected_revision",
    "batch"
  ],
  "title": "AdmissionEnvelope",
  "type": "object"
}
